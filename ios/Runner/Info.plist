<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LoveDay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>loveday</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- Camera & Photo Library Permissions (Dành cho Chuỗi ảnh Streak & Kỷ niệm) -->
	<key>NSCameraUsageDescription</key>
	<string>LoveDay cần quyền truy cập camera để bạn chụp và gửi ảnh giữ chuỗi cho người yêu</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LoveDay cần quyền truy cập thư viện ảnh để bạn tải ảnh kỷ niệm lên dòng thời gian</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>LoveDay cần quyền micro để bạn ghi âm lời nhắn yêu thương gửi cho đối phương</string>

	<!-- Cấu hình Đổi Icon App linh hoạt (Dynamic Icons giống Locket) -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>icon_golden</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>icon_golden</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>icon_dark</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>icon_dark</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>icon_pixel</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>icon_pixel</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>icon_sakura</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>icon_sakura</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>icon_diamond</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>icon_diamond</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
		</dict>
	</dict>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
